# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=/v1

# Database Configuration
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/datamanager_db?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets
JWT_ACCESS_SECRET="change-this-super-secret-access-key-minimum-32-chars"
JWT_REFRESH_SECRET="change-this-super-secret-refresh-key-minimum-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Storage Configuration (Local, S3, Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_BUCKET=data-manager-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Master Encryption Key (AES-256-GCM Envelope KEK - 32 Bytes hex)
MASTER_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
