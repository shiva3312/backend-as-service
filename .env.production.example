# Production Environment Configuration Template
PORT=3000
NODE_ENV=production
API_PREFIX=/v1

# PostgreSQL Database Configuration (Internal Docker container reference)
POSTGRES_USER=datamanager_prod
POSTGRES_PASSWORD=replace_with_secure_db_password_here
POSTGRES_DB=datamanager_prod_db
DATABASE_URL="postgresql://datamanager_prod:replace_with_secure_db_password_here@postgres:5432/datamanager_prod_db?schema=public"

# Redis Configuration (Internal Docker container reference)
REDIS_HOST=redis
REDIS_PORT=6379

# Cryptographic JWT Secrets (Generate high-entropy 64-char strings)
JWT_ACCESS_SECRET="REPLACE_WITH_HIGH_ENTROPY_ACCESS_SECRET_32_PLUS_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_HIGH_ENTROPY_REFRESH_SECRET_32_PLUS_CHARS"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Argon2 Password Salt Secret (Optional high-entropy pepper string)
ARGON_SECRET="REPLACE_WITH_ARGON2_PEPPER_SECRET_IF_USED"

# Storage Configuration (local, s3, or r2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads

# S3 / Cloudflare R2 Credentials (Optional if STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=prod-data-manager-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Master Encryption Key (32-byte hex string = 64 hex characters for AES-256-GCM Envelope KEK)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
